SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
MEDIA_ROOT=media
MEDIA_URL=/media/
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────
# To enable real email delivery:
#   1. Use a Gmail account (or create a dedicated one, e.g. lydo.lucena@gmail.com)
#   2. Enable 2-Step Verification on that Google account
#   3. Go to: Google Account → Security → App Passwords
#   4. Create an App Password (select "Mail" + "Other", name it "LYDO Hub")
#   5. Copy the 16-character password into EMAIL_HOST_PASSWORD below
#   6. Change EMAIL_BACKEND to the smtp line below
#
# For local testing only (prints emails to console — no credentials needed):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# For real Gmail sending (uncomment and fill in):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Frontend URL — used in email verification links (change for production)
FRONTEND_URL=http://localhost:5173
# ── Google Sign-In (OAuth 2.0) ─────────────────────────────────────────────
# To enable "Sign in with Google":
#   1. Go to https://console.developers.google.com/
#   2. Create a project (or select existing)
#   3. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#   4. Application type: Web application
#   5. Authorized JavaScript origins: http://localhost:5173 (and your prod domain)
#   6. Authorized redirect URIs: not needed for the implicit flow used here
#   7. Copy the Client ID below (looks like: 123456789-abc....apps.googleusercontent.com)
#   8. Also set VITE_GOOGLE_CLIENT_ID in frontend/.env to the same value
GOOGLE_CLIENT_ID=your-google-client-id-here
